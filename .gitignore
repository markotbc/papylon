# Dependencies / builds
node_modules/
wp-content/themes/woodmart-child/assets/dest/css/*
!wp-content/themes/woodmart-child/assets/dest/css/.gitkeep

# Local working files (scripts, exports; may contain credentials)
files/

# Never commit WordPress core, uploads, config or secrets
wp-config.php
.env
*.sql
*.sql.gz
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/index.php
wp-content/plugins/*
!wp-content/plugins/papylon-pangraf-sync/
wp-content/themes/*
!wp-content/themes/woodmart-child/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.log
*.map

# Built JS (generated by Gulp in CI)
wp-content/themes/woodmart-child/assets/dest/js/*
!wp-content/themes/woodmart-child/assets/dest/js/.gitkeep
